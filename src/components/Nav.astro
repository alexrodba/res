---
import { withBase } from '../lib/base';

const links = [
  { href: '/posts', label: 'Notícies' },
  { href: '/concerts', label: 'Concerts' },
  { href: '/music', label: 'Música' },
  { href: '/lyrics', label: 'Lletres' },
  { href: '/premsa', label: 'Premsa' },
  { href: '/about', label: 'Qui som' },
];

// Highlight the section the current page belongs to (incl. its detail pages).
const path = Astro.url.pathname.replace(/\/$/, '');
const isActive = (href: string) => {
  const full = withBase(href).replace(/\/$/, '');
  return path === full || path.startsWith(full + '/');
};
---

<nav id="nav" aria-label="Principal">
  <a href={withBase('/')} class="nav-logo">No som <em>RES!</em></a>
  <button class="nav-toggle" aria-label="Obrir menú" aria-expanded="false" aria-controls="nav-menu">
    <span></span><span></span><span></span>
  </button>
  <ul class="nav-links" id="nav-menu">
    {links.map((link) => (
      <li>
        <a href={withBase(link.href)} aria-current={isActive(link.href) ? 'page' : undefined}>{link.label}</a>
      </li>
    ))}
  </ul>
</nav>

<script>
  const nav = document.getElementById('nav');
  const toggle = nav?.querySelector('.nav-toggle');
  const menu = document.getElementById('nav-menu');

  window.addEventListener('scroll', () => {
    nav?.classList.toggle('scrolled', window.scrollY > 60);
  });

  function setMenu(open: boolean) {
    nav?.classList.toggle('menu-open', open);
    toggle?.setAttribute('aria-expanded', String(open));
    toggle?.setAttribute('aria-label', open ? 'Tancar menú' : 'Obrir menú');
  }

  toggle?.addEventListener('click', () => {
    setMenu(!nav?.classList.contains('menu-open'));
  });

  // Close when a link is tapped or on Escape
  menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setMenu(false)));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setMenu(false); });
</script>
