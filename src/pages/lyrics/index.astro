---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { albums } from '../../data/albums';
import { withBase } from '../../lib/base';

const allLyrics = await getCollection('lyrics');

// Group and sort lyrics by album, using albums.ts track order
const byAlbum = new Map<string, typeof allLyrics>();
for (const album of albums) {
  const songs = allLyrics.filter((l) => l.data.album === album.name);
  songs.sort((a, b) => {
    const ai = album.songs.indexOf(a.data.title);
    const bi = album.songs.indexOf(b.data.title);
    return ai - bi;
  });
  byAlbum.set(album.name, songs);
}

const description =
  'Totes les lletres de No som RES!, cançó per cançó, dels àlbums «Sou tots uns fills de puta» (2022) i «Les teves merdes» (2023).';
---

<Layout title="Lletres" description={description}>
  <div class="page-wrap">
    <h1 class="page-title">Lletres</h1>

    {albums.map((album, ai) => {
      const songs = byAlbum.get(album.name) ?? [];
      return (
        <>
          <div class="lyrics-album-header" style={ai > 0 ? 'margin-top:60px;' : ''}>
            <span class="lyrics-album-title">{album.name}</span>
            <span class="lyrics-album-year">{album.year}</span>
          </div>
          <div class="lyrics-grid">
            {songs.map((lyric, j) => (
              <details class="lyric-row">
                <summary class="lyric-header">
                  <span class="lyric-num">{String(j + 1).padStart(2, '0')}</span>
                  <span class="lyric-title">{lyric.data.title}</span>
                  <span class="lyric-plus" aria-hidden="true">+</span>
                </summary>
                <div class="lyric-body">
                  {lyric.body}
                  <a href={withBase(`/lyrics/${lyric.id}`)} class="lyric-page-link">Veure lletra completa →</a>
                </div>
              </details>
            ))}
          </div>
        </>
      );
    })}
  </div>
</Layout>
