---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { withBase } from '../../lib/base';

export async function getStaticPaths() {
  const lyrics = await getCollection('lyrics');
  return lyrics.map((lyric) => ({
    params: { slug: lyric.id },
    props: { lyric },
  }));
}

const { lyric } = Astro.props;
---

<Layout title={lyric.data.title}>
  <div class="page-wrap">
    <p class="breadcrumb">
      <a href={withBase('/lyrics')}>Lletres</a>
      <span class="sep">/</span>
      <a href={withBase('/lyrics')}>{lyric.data.album}</a>
    </p>

    <h1 class="page-title">{lyric.data.title}</h1>

    <div class="lyric-content">{lyric.body}</div>

    <footer class="lyric-footer">
      <span>{lyric.data.album} · {lyric.data.date.getFullYear()}</span>
      <span>{lyric.data.composer}</span>
      <span>Mescla: {lyric.data.mixer}</span>
    </footer>
  </div>
</Layout>
