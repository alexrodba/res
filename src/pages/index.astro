---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import NewsCard from '../components/NewsCard.astro';
import ConcertList from '../components/ConcertList.astro';
import PressList from '../components/PressList.astro';
import Contact from '../components/Contact.astro';
import { press } from '../data/press';
import { albums } from '../data/albums';
import { upcomingConcerts, pastConcerts } from '../data/concerts';
import { withBase } from '../lib/base';

// Notícies — 3 most recent posts
const allPosts = await getCollection('posts');
allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const recentPosts = allPosts.slice(0, 3);

// Concerts — show up to 3 upcoming; only fall back to past when nothing is planned
const upcoming = upcomingConcerts();
const past = pastConcerts();
const homepageConcerts = upcoming.length ? upcoming.slice(0, 3) : past.slice(0, 3);
const homepageConcertVariant = upcoming.length ? 'upcoming' : 'past';

// Premsa — 3 most recent features
const recentPress = press.slice(0, 3);

const description =
  "No som RES!, punk rock en català des de Barcelona. Dos àlbums — «Sou tots uns fills de puta» (2022) i «Les teves merdes» (2023) — notícies, concerts i lletres.";

// MusicGroup schema so search engines and AI answers get the band, the line-up
// era and the discography from one place instead of guessing from the copy.
const schema = {
  '@context': 'https://schema.org',
  '@type': 'MusicGroup',
  name: 'No som RES!',
  alternateName: 'RES!',
  url: new URL('/', Astro.site).href,
  description,
  genre: ['Punk rock', 'Punk'],
  foundingDate: '2021',
  foundingLocation: {
    '@type': 'Place',
    name: 'Barcelona, Catalunya',
  },
  inLanguage: 'ca',
  email: 'hola@nosomres.cat',
  sameAs: [
    'https://www.instagram.com/res_punk/',
    'https://open.spotify.com/artist/5TGsKoYoodgc42udARkKA4',
    'https://resbcn.bandcamp.com',
  ],
  album: albums.map((album) => ({
    '@type': 'MusicAlbum',
    name: album.name,
    datePublished: String(album.year),
    numTracks: album.songs.length,
    byArtist: { '@type': 'MusicGroup', name: 'No som RES!' },
    url: `https://open.spotify.com/album/${album.spotifyId}`,
  })),
};
---

<Layout description={description} schema={schema}>
<!-- ─── HERO ─── -->
<section id="hero">
  <div class="hero-bg" style={`background-image: url('${withBase('/img/bg2.jpeg')}');`}></div>
  <div class="hero-overlay"></div>
  <div class="hero-scanlines"></div>
  <h1 class="hero-stack" aria-label="No som RES!">
    <span class="r">NO</span>
    <span class="r">SOM</span>
    <span class="r">RES!</span>
  </h1>
  <div class="hero-hud">
    <div>
      <span class="hero-tag">Punk Rock · Barcelona · 2021</span>
      <p class="hero-desc">Tres paios en plena crisi dels 40.<br>Zero coneixements musicals i vestint com adolescents.</p>
    </div>
    <div class="hero-ctas">
      <a href="https://open.spotify.com/artist/5TGsKoYoodgc42udARkKA4" target="_blank" rel="noopener" class="btn btn-fill">Escolta'ns</a>
      <a href={withBase('/concerts')} class="btn btn-outline">Concerts</a>
    </div>
  </div>
  <div class="scroll-hint">
    <span>scroll</span>
    <div class="scroll-bar"></div>
  </div>
</section>

<!-- ─── TICKER ─── -->
<div class="ticker">
  <div class="ticker-track">
    <span class="ticker-item">Punk Rock Barcelona</span><span class="ticker-sep ticker-item">///</span>
    <span class="ticker-item">Les Teves Merdes — 2023</span><span class="ticker-sep ticker-item">///</span>
    <span class="ticker-item">Sou Tots Uns Fills De Puta — 2022</span><span class="ticker-sep ticker-item">///</span>
    <span class="ticker-item">@res_punk</span><span class="ticker-sep ticker-item">///</span>
    <span class="ticker-item">Spotify · Bandcamp</span><span class="ticker-sep ticker-item">///</span>
    <span class="ticker-item">Punk Rock en Català</span><span class="ticker-sep ticker-item">///</span>
    <span class="ticker-item">La Trinca del Punk Rock</span><span class="ticker-sep ticker-item">///</span>
    <span class="ticker-item">Les Teves Merdes — 2023</span><span class="ticker-sep ticker-item">///</span>
    <span class="ticker-item">Sou Tots Uns Fills De Puta — 2022</span><span class="ticker-sep ticker-item">///</span>
    <span class="ticker-item">@res_punk</span><span class="ticker-sep ticker-item">///</span>
    <span class="ticker-item">Troba'ns a Spotify i Bandcamp</span><span class="ticker-sep ticker-item">///</span>
    <span class="ticker-item">Punk Rock en Català</span><span class="ticker-sep ticker-item">///</span>
  </div>
</div>

<!-- ─── NEWS ─── -->
<section>
  <div class="section">
    <h2 class="eyebrow">Notícies</h2>
    <div class="news-grid">
      {recentPosts.map((post) => <NewsCard post={post} />)}
    </div>
    <div style="margin-top:48px;">
      <a href={withBase('/posts')} class="btn btn-outline">Totes les notícies →</a>
    </div>
  </div>
</section>

<!-- ─── PHOTO BREAK 1 ─── -->
<div class="photo-break">
  <div class="photo-break-bg" style={`background-image: url('${withBase('/img/bg2.jpeg')}');`}></div>
  <div class="photo-break-overlay"></div>
  <div class="photo-break-text">
    <div class="photo-quote">
      Curt.
      <em>Catchy.</em>
      En català.
    </div>
  </div>
</div>

<!-- ─── CONCERTS ─── -->
<section id="concerts">
  <div class="section-full" style="max-width:1280px; margin:0 auto;">
    <h2 class="eyebrow">Concerts</h2>
    {homepageConcerts.length > 0 ? (
      <>
        <ConcertList concerts={homepageConcerts} variant={homepageConcertVariant} />
        <div style="margin-top:40px;">
          <a href={withBase('/concerts')} class="btn btn-outline">Tots els concerts →</a>
        </div>
      </>
    ) : (
      <div class="concert-empty">
        <div class="concert-empty-title">Ara mateix,<br><em>cap concert</em> a la vista.</div>
        <p class="concert-empty-text">Estem tancats a les nostres respectives cases gestionant vides complicades. Les properes dates apareixeran aquí algun dia. Segueix-nos per no perdre-te'n cap.</p>
        <div class="concert-empty-cta">
          <a href="https://www.instagram.com/res_punk/" target="_blank" rel="noopener" class="btn btn-fill">Segueix-nos a Instagram</a>
          <a href="https://open.spotify.com/artist/5TGsKoYoodgc42udARkKA4?si=xCq32A21QwKl8XnxhPct8w" target="_blank" rel="noopener" class="btn btn-outline">Escolta'ns a Spotify</a>
        </div>
      </div>
    )}
  </div>
</section>

<!-- ─── MEDIA (Fotos & Vídeos) — hidden until we have real material ─── -->
{/* Pulled from the homepage: the six photos were on-brand placeholders, and the
    videos row pointed at a YouTube channel that doesn't exist yet. The
    placeholder SVGs (/img/media/ph-0*.svg) and the .media-photos / .videos-grid
    styles are still in the repo, so restoring this is a paste away once there
    are real photos and a live channel. */}

<!-- ─── PHOTO BREAK 2 ─── -->
<div class="photo-break" style="height:32vh; min-height:220px;">
  <div class="photo-break-bg" style={`background-image: url('${withBase('/img/bg2.jpeg')}'); background-position: center 35%;`}></div>
  <div class="photo-break-overlay" style="background: linear-gradient(to bottom, rgba(10,10,9,0.3), rgba(10,10,9,0.7));"></div>
</div>

<!-- ─── PREMSA ─── -->
{recentPress.length > 0 && (
  <section id="premsa">
    <div class="section">
      <h2 class="eyebrow">Premsa</h2>
      <div class="press-intro">
        <h2 class="press-heading">On hem <em>sortit.</em></h2>
        <p class="press-lead">Ressenyes, entrevistes i llistes on ens han fet un lloc. Res de màrqueting: només gent que ens ha escoltat.</p>
      </div>
      <PressList items={recentPress} />
      <div style="margin-top:40px;">
        <a href={withBase('/premsa')} class="btn btn-outline">Tota la premsa →</a>
      </div>
    </div>
  </section>
)}

<!-- ─── CONTACT ─── -->
<Contact />
</Layout>
