---
// ─────────────────────────────────────────────────────────────
// INTERNAL — Full axe-core audit, before/after comparison.
//   Group 1  Contrast (serious · 1.4.3)      — 6 items, live ratio
//   Group 2  Estructura (moderate)           — landmarks / regions, code diff
//   Group 3  Contrast indeterminat (incomplete) — manual-review treatments
// URL: /design-system/contrast · noindex
// ─────────────────────────────────────────────────────────────
import '../../styles/global.css';
import { withBase } from '../../lib/base';

const contrastItems = [
  {
    title: 'Cos de text esmorteït',
    components: '.n-body · .about-text · .lyric-body · .prose-content · .hero-desc',
    bg: '#0a0a09',
    sample: 'Punk rock en català des de Barcelona. Dos àlbums, molts concerts, cap intenció de callar.',
    size: 13, weight: 400, ls: 0, upper: false,
    before: { color: 'rgba(240,236,226,0.45)', label: '--mid · rgba(240,236,226,0.45)' },
    after:  { color: 'rgba(240,236,226,0.62)', label: '--mid → rgba(240,236,226,0.62)' },
    note: 'Puja només l’opacitat del token de text de cos. Canvi visual mínim, aclareix tot el text llarg.',
  },
  {
    title: 'Etiquetes fantasma',
    components: '.nav-links · .c-badge · .c-sold · .n-date · .c-loc · .breadcrumb · album-info',
    bg: '#0a0a09',
    sample: 'Notícies · 15 Abr 2026 · Barcelona',
    size: 10, weight: 400, ls: 3, upper: true,
    before: { color: 'rgba(240,236,226,0.18)', label: '--dim · rgba(240,236,226,0.18)' },
    after:  { color: 'rgba(240,236,226,0.52)', label: 'nou --dim-text · rgba(240,236,226,0.52)' },
    note: 'Manté --dim (0.18) per a vores/decoració; crea --dim-text per a qualsevol etiqueta que sigui text real.',
  },
  {
    title: 'Text del footer',
    components: '.footer-copy · .footer-nav a',
    bg: '#050504',
    sample: '© 2026 No som RES! · Tots els drets reservats',
    size: 9, weight: 400, ls: 2, upper: true,
    before: { color: '#222222', label: 'literal #222' },
    after:  { color: '#8a8a86', label: '#8a8a86' },
    note: 'El gris del footer és pràcticament invisible sobre el negre. Un gris mitjà el fa llegible sense trencar el to discret.',
  },
  {
    title: 'Micro-etiquetes en vermell',
    components: '.eyebrow · .hero-tag · .c-mon · .a-yr · .member-role · .lyric-num',
    bg: '#0a0a09',
    sample: 'Propers concerts',
    size: 9, weight: 400, ls: 5, upper: true,
    before: { color: '#e8001d', label: '--red · #e8001d' },
    after:  { color: '#ff3446', label: 'nou --red-text · #ff3446' },
    note: 'El vermell de marca passa en mides grans (titulars). Només falla en etiquetes petites: usa un vermell lleugerament més clar per a text < 14px.',
  },
  {
    title: 'Text sobre farciment vermell',
    components: '.btn-fill · .ticker-item · #contact · .sg-bar',
    bg: '#e8001d',
    sample: 'Escolta ara',
    size: 9, weight: 700, ls: 4, upper: true,
    before: { color: 'rgba(240,236,226,1)', label: '--bone · #f0ece2' },
    after:  { color: '#ffffff', label: '#ffffff' },
    note: 'Sobre el vermell, el bone crema es queda curt a 9px. Blanc pur just passa; idealment també ≥ 12–14px.',
  },
  {
    title: 'Subtítol sobre portada clara',
    components: '.album-art-1 .album-sub',
    bg: '#ddd8ce',
    sample: 'Les Teves Merdes',
    size: 9, weight: 400, ls: 4, upper: true,
    before: { color: '#e8001d', label: '--red · #e8001d' },
    after:  { color: '#900014', label: '#900014 (vermell tinta)' },
    note: 'Sobre el fons clar de la portada cal el contrari: un vermell més FOSC. El vermell sang manté l’actitud i passa AA.',
  },
];

// Incomplete (axe no pot calcular: text sobre imatge + text-shadow).
// bg = pixel clar realista del pitjor fotograma; el fix garanteix un scrim.
const reviewItems = [
  {
    title: 'Wordmark de l’hero sobre foto',
    components: '.hero-stack .r  (sobre .hero-bg)',
    display: true,
    sample: 'RES!',
    size: 46, weight: 400, ls: -2, upper: true,
    beforeBg: '#7a7a7a', afterBg: '#141413',
    before: { color: '#f0ece2', label: 'bone sobre àrea clara de la foto' },
    after:  { color: '#f0ece2', label: 'bone + scrim ≥55% a sota del text' },
    note: 'La foto és variable: en fotogrames foscos passa, però una zona clara pot deixar el text per sota d’AA. Reforça el gradient/scrim darrere del wordmark perquè passi sempre, sigui quina sigui la imatge.',
  },
  {
    title: 'Cita del photo-break sobre foto',
    components: '.photo-quote · .photo-quote em',
    display: true,
    sample: 'Una sola idea',
    size: 30, weight: 400, ls: 2, upper: true,
    beforeBg: '#8a8a8a', afterBg: '#141413',
    before: { color: '#e8001d', label: 'vermell sobre àrea clara' },
    after:  { color: '#ff3446', label: 'vermell text + scrim central' },
    note: 'El vermell sobre una zona clara de la foto és el cas més arriscat (contrast ~1:1). L’overlay del photo-break ja hi ajuda; afegeix una franja fosca darrere la cita per garantir-ho.',
  },
];
---

<!doctype html>
<html lang="ca">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Audit A11y · Abans/Després — No som RES! [INTERN]</title>
    <link rel="icon" href={withBase('/favicon.ico')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Anton&family=Space+Mono:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet" />
    <style>
      body { padding: 0; }
      .sg-bar { position: sticky; top: 0; z-index: 50; background: var(--red); color: var(--bone); padding: 10px 40px; font-size: 9px; letter-spacing: 4px; text-transform: uppercase; display: flex; justify-content: space-between; align-items: center; }
      .sg-bar a { color: #fff; border-bottom: 1px solid rgba(255,255,255,0.5); padding-bottom: 1px; }
      .wrap { max-width: 1040px; margin: 0 auto; padding: 56px 40px 120px; }
      .lede { font-family: 'Anton', sans-serif; font-size: clamp(36px, 6vw, 60px); line-height: 0.9; letter-spacing: -2px; margin-bottom: 16px; }
      .lede em { font-style: normal; color: var(--red); }
      .sub { font-size: 13px; line-height: 1.9; color: rgba(240,236,226,0.62); max-width: 640px; }
      .scoreboard { display: inline-flex; flex-wrap: wrap; gap: 0; margin: 28px 0 8px; border: 1px solid var(--line); font-size: 11px; letter-spacing: 1px; }
      .scoreboard div { padding: 12px 20px; border-right: 1px solid var(--line); }
      .scoreboard div:last-child { border-right: none; }
      .scoreboard b { font-family: 'Anton', sans-serif; font-size: 18px; letter-spacing: 0; }
      .legend { font-size: 10px; letter-spacing: 1px; color: rgba(240,236,226,0.5); margin-top: 12px; text-transform: uppercase; }

      .group-h { display: flex; align-items: baseline; gap: 16px; margin: 64px 0 4px; }
      .group-h h2 { font-family: 'Anton', sans-serif; font-size: 20px; letter-spacing: 2px; text-transform: uppercase; }
      .group-h .sev { font-size: 9px; letter-spacing: 3px; text-transform: uppercase; padding: 4px 10px; border: 1px solid var(--line); }
      .sev.serious { color: #ff5a6a; } .sev.moderate { color: #ffce54; } .sev.review { color: #7db4ff; }
      .group-sub { font-size: 11px; color: rgba(240,236,226,0.5); letter-spacing: 1px; margin-bottom: 8px; }

      .item { border-top: 1px solid var(--line); padding: 40px 0; }
      .item-head { display: flex; align-items: baseline; justify-content: space-between; gap: 24px; margin-bottom: 6px; flex-wrap: wrap; }
      .item-title { font-family: 'Anton', sans-serif; font-size: 24px; letter-spacing: 0.5px; }
      .item-wcag { font-size: 9px; letter-spacing: 3px; text-transform: uppercase; color: var(--red); border: 1px solid var(--line); padding: 5px 10px; white-space: nowrap; }
      .item-comp { font-family: 'Space Mono', monospace; font-size: 11px; color: rgba(240,236,226,0.5); margin-bottom: 4px; word-break: break-word; }
      .item-note { font-size: 12px; line-height: 1.8; color: rgba(240,236,226,0.62); max-width: 720px; margin: 8px 0 26px; }

      .compare { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
      .col { border: 1px solid var(--line); overflow: hidden; }
      .col-tag { font-size: 9px; letter-spacing: 4px; text-transform: uppercase; padding: 10px 16px; border-bottom: 1px solid var(--line); }
      .col-now .col-tag { color: rgba(240,236,226,0.55); }
      .col-fix .col-tag { color: #7CFF9B; }
      .stage { min-height: 120px; padding: 26px 22px; display: flex; align-items: center; }
      .stage p { margin: 0; }
      .stage.display p { font-family: 'Anton', sans-serif; line-height: 0.9; }
      .col-foot { border-top: 1px solid var(--line); padding: 12px 16px; display: flex; justify-content: space-between; align-items: center; gap: 12px; background: rgba(0,0,0,0.25); }
      .col-val { font-family: 'Space Mono', monospace; font-size: 10px; color: rgba(240,236,226,0.5); word-break: break-all; }
      .badge { font-family: 'Space Mono', monospace; font-size: 11px; font-weight: 700; letter-spacing: 1px; padding: 5px 10px; white-space: nowrap; flex-shrink: 0; }
      .badge.pass { background: rgba(60,220,120,0.14); color: #7CFF9B; }
      .badge.fail { background: rgba(232,0,29,0.16); color: #ff5a6a; }
      .badge.review { background: rgba(125,180,255,0.14); color: #7db4ff; }

      pre.code { margin: 0; padding: 20px 22px; font-family: 'Space Mono', monospace; font-size: 11px; line-height: 1.75; color: rgba(240,236,226,0.75); white-space: pre; overflow-x: auto; min-height: 120px; }
      pre.code .add { color: #7CFF9B; }
      pre.code .cmt { color: rgba(240,236,226,0.35); }
      .stage.imgnote { font-size: 9px; }

      @media (max-width: 720px) {
        .wrap { padding: 40px 20px 80px; }
        .compare { grid-template-columns: 1fr; }
      }
    </style>
  </head>
  <body>
    <header class="sg-bar">
      <span><strong>◉ Intern</strong> · Audit A11y — abans / després</span>
      <span><a href={withBase('/design-system')}>← Design System</a></span>
    </header>

    <main class="wrap">
      <h1 class="lede">Audit <em>A11y</em><br>Abans / Després</h1>
      <p class="sub">Totes les troballes d’axe-core (WCAG 2.1 AA) sobre el design system, amb la correcció proposada al costat. El contrast es calcula al navegador; els ítems d’estructura mostren el canvi de marcatge.</p>

      <div class="scoreboard">
        <div>Contrast ara: <b id="score-now">–</b>/6</div>
        <div>Amb fix: <b id="score-fix">–</b>/6</div>
        <div>Estructura: <b>0</b>→<b>1</b></div>
        <div>Revisió manual: <b>2</b></div>
      </div>
      <div class="legend">axe-core 4.10.2 · 3 tipus de violació + 10 nodes «incomplete» · llindar AA text normal = 4.5:1</div>

      <!-- ─── GROUP 1 · CONTRAST ─── -->
      <div class="group-h">
        <h2>Contrast</h2><span class="sev serious">Serious · 1.4.3</span>
      </div>
      <p class="group-sub">6 parells de color que no arriben a 4.5:1. Ràtio real calculada a cada columna.</p>

      {contrastItems.map((it) => {
        const s = `font-size:${it.size}px;${it.upper ? 'text-transform:uppercase;' : ''}letter-spacing:${it.ls}px;font-weight:${it.weight};line-height:1.85;`;
        return (
          <div class="item" data-type="contrast">
            <div class="item-head">
              <span class="item-title">{it.title}</span>
              <span class="item-wcag">WCAG 1.4.3 · AA</span>
            </div>
            <div class="item-comp">{it.components}</div>
            <p class="item-note">{it.note}</p>
            <div class="compare">
              <div class="col col-now">
                <div class="col-tag">Actual</div>
                <div class="stage" style={`background:${it.bg};`}>
                  <p data-contrast data-bg={it.bg} style={`${s}color:${it.before.color};`}>{it.sample}</p>
                </div>
                <div class="col-foot"><span class="col-val">{it.before.label}</span></div>
              </div>
              <div class="col col-fix">
                <div class="col-tag">Proposta</div>
                <div class="stage" style={`background:${it.bg};`}>
                  <p data-contrast data-bg={it.bg} style={`${s}color:${it.after.color};`}>{it.sample}</p>
                </div>
                <div class="col-foot"><span class="col-val">{it.after.label}</span></div>
              </div>
            </div>
          </div>
        );
      })}

      <!-- ─── GROUP 2 · ESTRUCTURA ─── -->
      <div class="group-h">
        <h2>Estructura</h2><span class="sev moderate">Moderate</span>
      </div>
      <p class="group-sub">Resol dues regles alhora: <code>landmark-one-main</code> + <code>region</code> (11 nodes).</p>

      <div class="item" data-type="code">
        <div class="item-head">
          <span class="item-title">Landmark &lt;main&gt; absent</span>
          <span class="item-wcag">Best-practice · Semantics</span>
        </div>
        <div class="item-comp">src/layouts/Layout.astro — &lt;Nav&gt; ja és &lt;nav&gt;, &lt;Footer&gt; ja és &lt;footer&gt;</div>
        <p class="item-note">El contingut entre la nav i el footer no viu dins de cap landmark, i no hi ha cap <code>&lt;main&gt;</code>. Embolcallar el <code>&lt;slot/&gt;</code> amb <code>&lt;main&gt;</code> resol les dues regles d’axe d’un sol cop. (Les pàgines del design system, que són HTML autònom, també ho necessiten.)</p>
        <div class="compare">
          <div class="col col-now">
            <div class="col-tag">Actual</div>
            <pre class="code">{`<body>
  <Nav />
  <slot />
  <Footer />
</body>`}</pre>
            <div class="col-foot"><span class="col-val">Layout.astro</span><span class="badge fail">Sense landmark</span></div>
          </div>
          <div class="col col-fix">
            <div class="col-tag">Proposta</div>
            <pre class="code">{`<body>
  <Nav />
`}<span class="add">{`  <main>
`}</span>{`    <slot />
`}<span class="add">{`  </main>
`}</span>{`  <Footer />
</body>`}</pre>
            <div class="col-foot"><span class="col-val">+ &lt;main&gt;</span><span class="badge pass">landmark-one-main + region ✓</span></div>
          </div>
        </div>
      </div>

      <!-- ─── GROUP 3 · REVISIÓ MANUAL ─── -->
      <div class="group-h">
        <h2>Contrast indeterminat</h2><span class="sev review">Incomplete · 10 nodes</span>
      </div>
      <p class="group-sub">Text sobre imatge + text-shadow: axe no ho pot calcular. Mostrem el pitjor fotograma i el tractament que ho garanteix.</p>

      {reviewItems.map((it) => {
        const s = `font-size:${it.size}px;text-transform:uppercase;letter-spacing:${it.ls}px;font-weight:${it.weight};`;
        return (
          <div class="item" data-type="review">
            <div class="item-head">
              <span class="item-title">{it.title}</span>
              <span class="item-wcag">WCAG 1.4.3 · revisar</span>
            </div>
            <div class="item-comp">{it.components}</div>
            <p class="item-note">{it.note}</p>
            <div class="compare">
              <div class="col col-now">
                <div class="col-tag">Pitjor cas (foto clara)</div>
                <div class="stage display" style={`background:${it.beforeBg};`}>
                  <p data-contrast data-bg={it.beforeBg} style={`${s}color:${it.before.color};`}>{it.sample}</p>
                </div>
                <div class="col-foot"><span class="col-val">{it.before.label}</span></div>
              </div>
              <div class="col col-fix">
                <div class="col-tag">Amb scrim</div>
                <div class="stage display" style={`background:${it.afterBg};`}>
                  <p data-contrast data-bg={it.afterBg} style={`${s}color:${it.after.color};`}>{it.sample}</p>
                </div>
                <div class="col-foot"><span class="col-val">{it.after.label}</span></div>
              </div>
            </div>
          </div>
        );
      })}
    </main>

    <script>
      const AA = 4.5;
      function parse(str) {
        str = str.trim();
        if (str[0] === '#') {
          let h = str.slice(1);
          if (h.length === 3) h = h.split('').map(c => c + c).join('');
          return { r: parseInt(h.slice(0,2),16), g: parseInt(h.slice(2,4),16), b: parseInt(h.slice(4,6),16), a: 1 };
        }
        const m = str.match(/rgba?\(([^)]+)\)/);
        const p = m[1].split(',').map(s => parseFloat(s));
        return { r: p[0], g: p[1], b: p[2], a: p[3] === undefined ? 1 : p[3] };
      }
      const blend = (fg, bg) => ({ r: fg.r*fg.a + bg.r*(1-fg.a), g: fg.g*fg.a + bg.g*(1-fg.a), b: fg.b*fg.a + bg.b*(1-fg.a) });
      const lin = c => { c /= 255; return c <= 0.03928 ? c/12.92 : Math.pow((c+0.055)/1.055, 2.4); };
      const lum = c => 0.2126*lin(c.r) + 0.7152*lin(c.g) + 0.0722*lin(c.b);
      const ratio = (a, b) => { const L1 = lum(a), L2 = lum(b), hi = Math.max(L1,L2), lo = Math.min(L1,L2); return (hi+0.05)/(lo+0.05); };

      function run() {
        let now = 0, fix = 0;
        document.querySelectorAll('[data-contrast]').forEach(el => {
          const fg = parse(getComputedStyle(el).color);
          const bg = parse(el.getAttribute('data-bg'));
          const r = ratio(blend(fg, bg), bg);
          const pass = r >= AA;
          const isFix = !!el.closest('.col-fix');
          const type = el.closest('.item').getAttribute('data-type');
          const badge = document.createElement('span');
          if (type === 'review' && !isFix) {
            badge.className = 'badge review';
            badge.textContent = '≈' + r.toFixed(2) + ':1 · REVISAR';
          } else {
            badge.className = 'badge ' + (pass ? 'pass' : 'fail');
            badge.textContent = r.toFixed(2) + ':1 · ' + (pass ? 'PASS' : 'FAIL');
          }
          el.closest('.col').querySelector('.col-foot').appendChild(badge);
          if (type === 'contrast') { if (pass) { isFix ? fix++ : now++; } }
        });
        document.getElementById('score-now').textContent = now;
        document.getElementById('score-fix').textContent = fix;
      }
      document.readyState === 'loading' ? document.addEventListener('DOMContentLoaded', run) : run();
    </script>
  </body>
</html>
