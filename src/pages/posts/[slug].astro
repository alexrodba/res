---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { withBase } from '../../lib/base';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

// The card excerpt doubles as the meta description; fall back to the headline
// so a post without one still gets something specific.
const description =
  post.data.excerpt ?? `${post.data.title} — notícies de No som RES!, punk rock en català des de Barcelona.`;

const BAND = { '@type': 'MusicGroup', name: 'No som RES!', url: new URL('/', Astro.site).href };
const postUrl = new URL(withBase(`/posts/${post.id}`), Astro.site).href;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'NewsArticle',
    headline: post.data.title,
    description,
    datePublished: post.data.date.toISOString(),
    inLanguage: 'ca',
    author: BAND,
    publisher: BAND,
    mainEntityOfPage: { '@type': 'WebPage', '@id': postUrl },
    image: new URL(withBase('/og/default.jpg'), Astro.site).href,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inici', item: new URL('/', Astro.site).href },
      { '@type': 'ListItem', position: 2, name: 'Notícies', item: new URL(withBase('/posts'), Astro.site).href },
      { '@type': 'ListItem', position: 3, name: post.data.title },
    ],
  },
];
---

<Layout
  title={post.data.title}
  description={description}
  ogType="article"
  publishedTime={post.data.date}
  schema={schema}
>
  <div class="page-wrap">
    <p class="breadcrumb">
      <a href={withBase('/posts')}>Notícies</a>
    </p>

    <h1 class="page-title">{post.data.title}</h1>

    <p class="post-date">
      <time datetime={post.data.date.toISOString().slice(0, 10)}>
        {post.data.date.toLocaleDateString('ca-ES', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })}
      </time>
    </p>

    <div class="prose-content">
      <Content />
    </div>
  </div>
</Layout>
