---
import Layout from '../layouts/Layout.astro';
import ConcertList from '../components/ConcertList.astro';
import PastConcerts from '../components/PastConcerts.astro';
import { upcomingConcerts, pastConcerts } from '../data/concerts';

const upcoming = upcomingConcerts();
const past = pastConcerts();

const description =
  "Concerts de No som RES!, punk rock en català des de Barcelona. Les properes dates i l'historial de concerts des del 2021.";
---

<Layout title="Concerts" description={description}>
  <div class="page-wrap">
    <h1 class="page-title">Concerts</h1>

    {upcoming.length > 0 ? (
      <section>
        <h2 class="eyebrow">Propers concerts</h2>
        <ConcertList concerts={upcoming} />
      </section>
    ) : (
      <div class="concert-empty">
        <div class="concert-empty-title">Ara mateix,<br><em>cap concert</em> a la vista.</div>
        <p class="concert-empty-text">Estem tancats a les nostres respectives cases gestionant vides complicades. Les properes dates apareixeran aquí algun dia. Segueix-nos per no perdre-te'n cap.</p>
        <div class="concert-empty-cta">
          <a href="https://www.instagram.com/res_punk/" target="_blank" rel="noopener" class="btn btn-fill">Segueix-nos a Instagram</a>
          <a href="https://open.spotify.com/artist/5TGsKoYoodgc42udARkKA4?si=xCq32A21QwKl8XnxhPct8w" target="_blank" rel="noopener" class="btn btn-outline">Escolta'ns a Spotify</a>
        </div>
      </div>
    )}

    {past.length > 0 && (
      <section style="margin-top: 72px;">
        <h2 class="eyebrow">Concerts passats</h2>
        <PastConcerts concerts={past} />
      </section>
    )}
  </div>
</Layout>
